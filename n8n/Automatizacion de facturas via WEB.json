        "jsCode": "const items = $input.all();\nconst newItems = [];\n\nfor (const item of items) {\n  if (item.binary) {\n    for (const key of Object.keys(item.binary)) {\n      newItems.push({\n        json: { binary_key: key },\n        binary: {\n          attachment_0: item.binary[key]\n        }\n      });\n    }\n  }\n}\n\nreturn newItems;\n\n// Esto convierte cada attachment en un item independiente, siempre con el nombre `attachment_0`, y así el **Analyze Document** siempre encuentra ese campo y procesa uno por llamada."
      },
