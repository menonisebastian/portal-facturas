    },
    {
      "parameters": {
        "url": "https://n8n-automatizacion.178.105.8.162.sslip.io/webhook/api-portal",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "numero",
              "value": "={{ $json.numero_factura }}"
            }
          ]
