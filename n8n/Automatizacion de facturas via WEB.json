    {
      "parameters": {
        "jsCode": "const newItems = [];\nconst items = $input.all(); // Obtenemos TODAS las respuestas de Gemini (los 3 ítems)\n\n// Recorremos cada respuesta una por una\nfor (let i = 0; i < items.length; i++) {\n  try {\n    // 1. Navegamos por la estructura exacta para ESTE ítem en concreto\n    let respuesta = items[i].json.content.parts[0].text;\n\n    // 2. Limpiamos el texto por si Gemini ha metido las comillas de Markdown\n    respuesta = respuesta.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n    // 3. Convertimos ese texto limpio en un objeto JSON real\n    const datos = JSON.parse(respuesta);\n\n    // 4. Lo añadimos a nuestra lista de nuevos ítems\n    newItems.push({ json: datos });\n    \n  } catch (error) {\n    /// Si falla la IA o está saturada, forzamos este mensaje\n    newItems.push({ \n      json: { \n        es_factura: false, \n        mensaje: \"El motor de IA está sobrecargado en este momento. Por favor, intenta de nuevo en unos minutos.\" \n      } \n    });\n  }\n}\n\n// Devolvemos los 3 ítems procesados\nreturn newItems;"
      },
