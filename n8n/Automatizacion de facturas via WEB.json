      "id": "b73177c6-f824-476e-989a-c979637cb5da",
      "name": "Ejecutar Data Endpoint"
    },
    {
      "parameters": {
        "jsCode": "// Buscar el archivo directamente desde los nodos de OneDrive disponibles\nlet id_del_excel = null;\nconst nombreArchivo = `Registro_Facturas_${$now.toFormat('yyyy-MM')}.xlsx`;\n\n// Intentar desde \"Buscar Archivo\" (nodo OneDrive que lista la carpeta)\ntry {\n  const archivos = $('Buscar Archivo').all();\n  for (const archivo of archivos) {\n    if (archivo.json.name === nombreArchivo) {\n      id_del_excel = archivo.json.id;\n      break;\n    }\n  }\n} catch(e) {\n  console.log('Error leyendo Buscar Archivo:', e.message);\n}\n\n// Si no, intentar desde \"Filtrar archivo\"\nif (!id_del_excel) {\n  try {\n    const filtro = $('Filtrar archivo').all();\n    for (const f of filtro) {\n      if (f.json.id) {\n        id_del_excel = f.json.id;\n        break;\n      }\n    }\n  } catch(e) {}\n}\n\n// Si no, intentar desde \"Creación desde plantilla\" (cuando SÍ creó bien)\nif (!id_del_excel) {\n  try {\n    const creacion = $('Creación desde plantilla').all();\n    for (const c of creacion) {\n      if (c.json.id && !c.json.error) {\n        id_del_excel = c.json.id;\n        break;\n      }\n    }\n  } catch(e) {}\n}\n\nconsole.log('Nombre buscado:', nombreArchivo);\nconsole.log('ID encontrado:', id_del_excel);\n\nif (!id_del_excel) {\n  // Mostrar qué hay disponible para debug\n  try {\n    const ba = $('Buscar Archivo').all();\n    console.log('Archivos en Buscar Archivo:', JSON.stringify(ba.map(x => ({name: x.json.name, id: x.json.id}))));\n  } catch(e) {}\n  throw new Error(`No se encontró el archivo \"${nombreArchivo}\" en OneDrive.`);\n}\n\nconst facturas = $('Limpiar JSON de Gemini').all();\nreturn facturas.map(f => ({\n  json: { ...JSON.parse(JSON.stringify(f.json)), excel_id: id_del_excel }\n}));"
      },
