    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    // Extraemos la fila actual del Excel\n    const fila = item.json;\n\n    return {\n        id: fila[\"NUMERO\"] || \"Sin ID\",\n        client: fila[\"PROVEEDOR\"] || \"Desconocido\",\n        date: fila[\"FECHA FACTURA\"] || \"Sin fecha\",\n        amount: fila[\"TOTAL\"] || \"0\",\n        currency: fila[\"MONEDA\"]   || \"EUR\",\n        // Como no tienes una columna exacta de \"Estado\", usamos \"PROCESADO\" por defecto\n        // o validamos si tiene \"FECHA PROCESO\"\n        status: fila[\"FECHA PROCESO\"] ? \"PROCESADO\" : \"PENDIENTE\"\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        16
      ],
      "id": "3972f80e-1970-4b94-b3fe-7da52747b401",
      "name": "Extraer lista"
    },
    {
      "parameters": {
        "jsCode": "const numero = $('Webhook').item.json.query.numero;\nconst filas = $input.all();\n\nconst encontrada = filas.find(item => \n    String(item.json['NUMERO']).trim() === String(numero).trim()\n);\n\nif (encontrada) {\n    return [{\n        json: {\n            encontrado: true,\n            factura: {\n                id: encontrada.json['NUMERO'],\n                client: encontrada.json['PROVEEDOR'],\n                date: encontrada.json['FECHA FACTURA'],\n                amount: encontrada.json['TOTAL'],\n                status: encontrada.json['FECHA PROCESO'] ? 'PROCESADO' : 'PENDIENTE'\n            }\n        }\n    }];\n} else {\n    return [{ json: { encontrado: false } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -176
      ],
      "id": "edcda6fe-3d50-438d-9577-8f8646dd30a4",
      "name": "Extraer registro"
    },
    {
      "parameters": {
        "jsCode": "// Lee el parámetro ?mes=yyyy-MM, si no viene usa el mes actual\nconst queryMes = $('Webhook').item.json.query?.mes || null;\n\nlet targetYM;\nif (queryMes && /^\\d{4}-\\d{2}$/.test(queryMes)) {\n  targetYM = queryMes;\n} else {\n  const now = new Date();\n  targetYM = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;\n}\n\nreturn [{ json: { targetYM, archivoObjetivo: `Registro_Facturas_${targetYM}.xlsx` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ],
      "id": "e83e3f5d-edd6-4d34-8f95-6d728a9b4c3e",
      "name": "Resolver Mes"
    },
    {
      "parameters": {
        "jsCode": "const archivoObjetivo = $('Resolver Mes').item.json.archivoObjetivo;\nconst archivos = $input.all();\nconst encontrado = archivos.find(item => item.json.name === archivoObjetivo);\n\nif (encontrado) {\n  return [{ json: { existe: true, id: encontrado.json.id } }];\n} else {\n  return [{ json: { existe: false, id: null } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
