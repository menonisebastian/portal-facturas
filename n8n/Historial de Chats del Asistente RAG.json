    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    session_id,\n    MIN(created_at) as fecha_inicio,\n    COUNT(*) as num_mensajes,\n    (SELECT message->>'content' \n     FROM historial_chats_ia h2 \n     WHERE h2.session_id = h.session_id \n     AND message->>'type' = 'human'\n     ORDER BY id ASC LIMIT 1) as primer_mensaje\nFROM historial_chats_ia h\nGROUP BY session_id\nORDER BY MIN(created_at) DESC\nLIMIT 20",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
